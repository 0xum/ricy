diff --git a/src/shell/bar/widgets/taskbar_icon_motion.h b/src/shell/bar/widgets/taskbar_icon_motion.h
new file mode 100644
index 0000000..8351262
--- /dev/null
+++ b/src/shell/bar/widgets/taskbar_icon_motion.h
@@ -0,0 +1,111 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <numbers>
+
+namespace taskbar_icon_motion {
+  struct State {
+    bool running = false;
+    bool active = false;
+    bool minimized = false;
+  };
+
+  enum class Action { None, Launch, Focus, Restore, Minimize, Background, Close };
+
+  struct Frame {
+    float scaleX = 1.0F;
+    float scaleY = 1.0F;
+    float opacity = 1.0F;
+    // Logical pixels away from the bar edge; negative values move toward it.
+    float lift = 0.0F;
+  };
+
+  inline Action transition(State previous, State next) {
+    if (previous.running && !next.running) {
+      return Action::Close;
+    }
+    if (!previous.running && next.running) {
+      return Action::Launch;
+    }
+    if (!next.running) {
+      return Action::None;
+    }
+    if (!previous.minimized && next.minimized) {
+      return Action::Minimize;
+    }
+    if (previous.minimized && !next.minimized) {
+      return Action::Restore;
+    }
+    if (!previous.active && next.active) {
+      return Action::Focus;
+    }
+    if (previous.active && !next.active) {
+      return Action::Background;
+    }
+    return Action::None;
+  }
+
+  inline float duration(Action action) {
+    switch (action) {
+    case Action::Launch:
+      return 420.0F;
+    case Action::Restore:
+      return 360.0F;
+    case Action::Focus:
+      return 260.0F;
+    case Action::Minimize:
+      return 220.0F;
+    case Action::Background:
+      return 200.0F;
+    case Action::Close:
+      return 240.0F;
+    default:
+      return 0.0F;
+    }
+  }
+
+  inline Frame sample(Action action, float progress, Frame from = {}) {
+    const float p = std::clamp(progress, 0.0F, 1.0F);
+    Frame frame;
+    if (p > 0.0F && p < 1.0F) {
+      const float pulse = std::sin(std::numbers::pi_v<float> * p);
+      const float hops = std::abs(std::sin(2.0F * std::numbers::pi_v<float> * p)) * (1.0F - p);
+      switch (action) {
+      case Action::Launch:
+        frame.scaleX = frame.scaleY = 1.0F + 0.08F * pulse;
+        frame.lift = 4.0F * hops;
+        break;
+      case Action::Restore:
+        frame.scaleX = frame.scaleY = 1.0F + 0.06F * pulse;
+        frame.lift = 3.5F * hops;
+        break;
+      case Action::Focus:
+        frame.scaleX = frame.scaleY = 1.0F + 0.10F * pulse;
+        break;
+      case Action::Minimize:
+        frame.scaleX = 1.0F + 0.06F * pulse;
+        frame.scaleY = 1.0F - 0.14F * pulse;
+        frame.lift = -1.2F * pulse;
+        break;
+      case Action::Background:
+        frame.scaleX = frame.scaleY = 1.0F - 0.035F * pulse;
+        frame.opacity = 1.0F - 0.10F * pulse;
+        break;
+      case Action::Close:
+        frame.scaleX = frame.scaleY = 1.0F - 0.18F * pulse;
+        frame.opacity = 1.0F - 0.40F * pulse;
+        break;
+      default:
+        break;
+      }
+    }
+    // New transitions start at the currently rendered values, including an interrupted bounce.
+    const float carry = (1.0F - p) * (1.0F - p);
+    frame.scaleX += (from.scaleX - 1.0F) * carry;
+    frame.scaleY += (from.scaleY - 1.0F) * carry;
+    frame.opacity = std::clamp(frame.opacity + (from.opacity - 1.0F) * carry, 0.0F, 1.0F);
+    frame.lift += from.lift * carry;
+    return frame;
+  }
