+void TaskbarWidget::applyAppOrder(std::vector<TaskModel>& tasks) {
+  std::vector<std::string> apps;
+  std::vector<std::string> retained;
+  for (const auto& task : tasks) {
+    apps.push_back(!task.idLower.empty() ? task.idLower : task.appIdLower);
+    const auto previous = std::ranges::find_if(m_tasks, [&task](const TaskModel& old) {
+      if (task.pinned) {
+        return old.pinned && old.desktopEntryId == task.desktopEntryId;
+      }
+      return !old.pinned
+          && ((task.handleKey != 0 && old.handleKey == task.handleKey)
+              || (!task.exactWindowId.empty() && old.exactWindowId == task.exactWindowId));
+    });
+    retained.push_back(previous != m_tasks.end() ? previous->orderKey : std::string{});
+  }
+  const auto keys = taskbar_order::keys(apps, retained);
+  for (std::size_t i = 0; i < tasks.size(); ++i) {
+    tasks[i].orderKey = keys[i];
+  }
+  const auto ranks = taskbar_order::ranks(m_configOptions.appOrder);
+  const auto rank = [&ranks](const TaskModel& task) {
+    const auto it = ranks.find(task.orderKey);
+    return it != ranks.end() ? it->second : std::numeric_limits<std::size_t>::max();
+  };
+  std::ranges::stable_sort(tasks, [&rank](const TaskModel& a, const TaskModel& b) { return rank(a) < rank(b); });
+}
