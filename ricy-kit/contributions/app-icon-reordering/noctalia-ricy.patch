+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace taskbar_order {
+
+  // App identity + occurrence keeps individual windows separate, without storing
+  // window titles or compositor UUIDs in the persistent preference.
+  inline std::vector<std::string>
+  keys(const std::vector<std::string>& apps, const std::vector<std::string>& retained = {}) {
+    std::unordered_map<std::string, std::size_t> occurrences;
+    std::unordered_set<std::string> used;
+    std::vector<std::string> result(apps.size());
+    for (std::size_t i = 0; i < apps.size() && i < retained.size(); ++i) {
+      const auto prefix = std::to_string(apps[i].size()) + ":" + apps[i] + ":";
+      if (retained[i].starts_with(prefix) && used.insert(retained[i]).second) {
+        result[i] = retained[i];
+      }
+    }
+    for (std::size_t i = 0; i < apps.size(); ++i) {
+      if (!result[i].empty()) {
+        continue;
+      }
+      const auto prefix = std::to_string(apps[i].size()) + ":" + apps[i] + ":";
+      do {
+        result[i] = prefix + std::to_string(occurrences[apps[i]]++);
+      } while (!used.insert(result[i]).second);
+    }
+    return result;
+  }
+
+  inline std::size_t target(std::size_t source, std::size_t count, float travel, float pitch) {
+    if (count == 0 || pitch <= 0.0F || !std::isfinite(pitch) || !std::isfinite(travel)) {
+      return source;
+    }
+    const double shifted = static_cast<double>(source) + std::round(static_cast<double>(travel) / pitch);
+    return static_cast<std::size_t>(std::clamp(shifted, 0.0, static_cast<double>(count - 1)));
+  }
+
+  inline bool move(std::vector<std::string>& values, std::size_t from, std::size_t to) {
+    if (from >= values.size() || to >= values.size() || from == to) {
+      return false;
+    }
+    std::string value = std::move(values[from]);
+    values.erase(values.begin() + static_cast<std::ptrdiff_t>(from));
+    values.insert(values.begin() + static_cast<std::ptrdiff_t>(to), std::move(value));
+    return true;
+  }
+
+  // Preserve slots belonging to closed apps or another monitor/workspace. A drop
+  // replaces only the visible subsequence, so reopening an app retains its place.
+  inline std::vector<std::string>
+  merge(const std::vector<std::string>& saved, const std::vector<std::string>& visible) {
+    const std::unordered_set<std::string> present(visible.begin(), visible.end());
+    std::unordered_set<std::string> seen;
+    std::vector<std::string> result;
+    std::size_t next = 0;
+    for (const auto& key : saved) {
+      if (!seen.insert(key).second) {
+        continue;
+      }
+      if (present.contains(key)) {
+        if (next < visible.size()) {
+          result.push_back(visible[next++]);
+        }
+      } else {
+        result.push_back(key);
+      }
+    }
+    result.insert(result.end(), visible.begin() + static_cast<std::ptrdiff_t>(next), visible.end());
+    return result;
+  }
+
+  inline std::unordered_map<std::string, std::size_t> ranks(const std::vector<std::string>& saved) {
+    std::unordered_map<std::string, std::size_t> result;
+    for (std::size_t i = 0; i < saved.size(); ++i) {
+      result.try_emplace(saved[i], i);
+    }
+    return result;
+  }
+
+} // namespace taskbar_order
