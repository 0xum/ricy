+      // PanelManager already removes panelPadding from the content bounds.
+      root()->setSize(width, height);
+      m_menu->setPosition(0.0F, 0.0F);
+      if (width != m_menuWidth) {
+        m_menu->setMenuWidth(width);
+        m_menuWidth = width;
+      }
+      root()->layout(renderer);
+    }
+    std::vector<ContextMenuControlEntry> m_entries;
+    std::function<void(const ContextMenuControlEntry&)> m_activate;
+    std::string m_position;
+    float m_menuWidth = -1.0F;
+    ContextMenuControl* m_menu = nullptr;
+  };
