+      return ContextMenuControl::preferredHeight(m_entries, m_entries.size(), contentScale())
+          + scaled(Style::panelPadding * 2.0F);
+    }
+
+    void create() override {
+      m_menuWidth = -1.0F;
+      auto root = std::make_unique<Node>();
+      auto menu = std::make_unique<ContextMenuControl>();
+      m_menu = menu.get();
+      menu->setContentScale(contentScale());
+      menu->setMaxVisible(m_entries.size());
+      menu->setEntries(m_entries);
+      menu->setRedrawCallback([] { PanelManager::instance().requestRedraw(); });
+      menu->setOnActivate([activate = m_activate](const ContextMenuControlEntry& entry) {
+        DeferredCall::callLater([activate, entry] {
+          PanelManager::instance().closePanelById(kTaskMenuPanelId);
+          activate(entry);
+        });
+      });
+      root->addChild(std::move(menu));
+      setRoot(std::move(root));
+    }
+
+    void onClose() override {
+      m_menu = nullptr;
+      clearReleasedRoot();
+    }
+
+    bool handleGlobalKey(std::uint32_t sym, std::uint32_t modifiers, bool pressed, bool preedit) override {
+      if (!pressed || preedit || modifiers != 0 || m_menu == nullptr)
+        return false;
+      if (sym == XKB_KEY_Return || sym == XKB_KEY_KP_Enter || sym == XKB_KEY_space) {
+        return m_menu->activateHighlighted();
+      }
+      if (sym != XKB_KEY_Up && sym != XKB_KEY_Down)
+        return false;
+      (void)m_menu->moveHighlight(sym == XKB_KEY_Up ? -1 : 1);
+      return true;
+    }
