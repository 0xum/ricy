/* Ricy: scoped to the Dolphin process; values follow the existing token contract. */
/* Inherit the active KDE/Qt application font, including its point size. */
QToolButton { border: 1px solid transparent; border-radius: 8px; padding: 4px; color: #cdd6f4; }
QToolButton:hover { background-color: #313244; border-color: #46485c; }
QToolButton:pressed, QToolButton:checked { background-color: #977dba; color: #000000; border-color: #977dba; }
QToolButton:focus { border-color: #cba6f7; }
QToolButton:disabled { background: transparent; border-color: transparent; color: #a6adc8; }
QLineEdit { background-color: #313244; color: #cdd6f4; border: 1px solid #46485c; border-radius: 8px; padding: 4px 8px; selection-background-color: #977dba; selection-color: #000000; }
QLineEdit:focus { border-color: #cba6f7; }
/* Opaque popup panel and inset rows; retain native actions and submenus. */
QMenu { background-color: #313244; color: #cdd6f4; border: 1px solid #46485c; border-radius: 12px; padding: 12px; }
QMenu::item { background: transparent; border: none; border-radius: 6px; padding: 4px 12px; margin: 1px 0px; }
QMenu::icon { left: 8px; }
QMenu::item:selected { background-color: #cba6f7; color: #11111b; }
QMenu::item:disabled { color: #a6adc8; }
QMenu::separator { height: 4px; background: transparent; margin: 0px 12px; }
QMenu QToolButton, QMenu QPushButton { background-color: #242435; color: #cdd6f4; border: 1px solid #46485c; border-radius: 6px; padding: 4px 8px; }
QMenu QToolButton:hover, QMenu QPushButton:hover { background-color: #977dba; color: #11111b; }
QMenu QToolButton:focus, QMenu QPushButton:focus { border-color: #cba6f7; }
/* Shared compact scrollbars across views, sidebars, dialogs and popups. */
QScrollBar:vertical { background-color: #242435; border: none; border-radius: 3px; width: 6px; margin: 0px; }
QScrollBar:horizontal { background-color: #242435; border: none; border-radius: 3px; height: 6px; margin: 0px; }
QScrollBar::handle:vertical { background-color: rgba(166,173,200,128); border: none; border-radius: 3px; min-height: 24px; }
QScrollBar::handle:horizontal { background-color: rgba(166,173,200,128); border: none; border-radius: 3px; min-width: 24px; }
QScrollBar::handle:hover { background-color: #a6adc8; }
QScrollBar::handle:pressed { background-color: #cba6f7; }
QScrollBar::add-line, QScrollBar::sub-line { background: transparent; border: none; width: 0px; height: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; border: none; }
/* Tabs like Noctalia buttons: neutral, hover and active. */
QTabBar { background: transparent; border: none; }
QTabBar::tab { background-color: #313244; color: #cdd6f4; border: 1px solid #46485c; border-radius: 12px; padding: 6px 14px; margin: 3px; }
QTabBar::tab:selected { background-color: #cba6f7; color: #11111b; border-color: #cba6f7; }
QTabBar::tab:hover { background-color: #977dba; color: #000000; border-color: #977dba; }
QTabBar::tab:selected:hover { background-color: #cba6f7; color: #11111b; border-color: #cba6f7; }
QTabBar QToolButton { padding: 2px; border: 1px solid transparent; border-radius: 8px; background: transparent; }
QTabBar QToolButton:hover { background-color: rgba(203,166,247,65); }
QTabBar QToolButton:focus { border-color: #cba6f7; }
QTabBar::close-button { width: 12px; height: 12px; }
QTabWidget::pane { border: none; background: transparent; }
QDockWidget { color: #a6adc8; }
QStatusBar { color: #a6adc8; }

/* Main panel and L panel: #313244; outer shell keeps glass. */
DolphinViewContainer { background-color: #313244; border: 1px solid transparent; border-radius: 12px; padding: 8px; margin: 4px 4px 8px 4px; }
DolphinViewContainer[ricyRightEdge="true"] { margin-right: 8px; }
DolphinViewContainer[ricyLeftEdge="true"] { margin-left: 8px; }
KItemListContainer { background: transparent; border: none; padding: 0px; margin: 0px; }
KItemListContainerViewport, KItemListContainerViewport > QWidget { background: transparent; border: none; }
QToolBar { background: transparent; border: none; spacing: 8px; min-height: 36px; padding: 8px 16px; }
QToolBar QToolButton { min-width: 20px; min-height: 20px; padding: 4px 8px; }
QToolBar QToolButton:hover { background-color: rgba(151,125,186,65); border-color: transparent; }
/* Hover must not erase a native checked/pressed action or its foreground. */
QToolBar QToolButton:checked, QToolBar QToolButton:pressed { background-color: #977dba; color: #000000; border-color: #977dba; }
QToolBar QToolButton:focus { border-color: #cba6f7; }
QToolBar QToolButton:disabled { background: transparent; border-color: transparent; color: #a6adc8; }
/* Own the split-menu surface as well as its glyph, preventing native duplication. */
QToolBar QToolButton::menu-indicator { width: 6px; height: 6px; subcontrol-origin: padding; subcontrol-position: bottom right; right: 4px; bottom: 4px; }
QToolBar QToolButton::menu-button { width: 16px; border: none; background: transparent; }
QToolBar QToolButton::menu-arrow { width: 6px; height: 6px; subcontrol-position: center; }
QToolBar QToolButton[popupMode="1"] { padding-right: 12px; }
/* Breadcrumbs stay light; only the editable path has a field backing. */
KUrlNavigator { background: transparent; border: none; }
KUrlNavigator QComboBox { background-color: #181825; border: 2px solid #cba6f7; border-radius: 8px; padding: 0px 8px 0px 12px; }
KUrlNavigator QComboBox:focus { border-color: #cba6f7; }
KUrlNavigator QComboBox::drop-down { border: none; background: transparent; width: 24px; }
KUrlNavigator QLineEdit { background: transparent; border: none; padding: 0px 12px; }
KUrlNavigator QLineEdit:focus { border: none; }
KUrlNavigator QAbstractButton { border: 1px solid transparent; border-radius: 6px; background: transparent; color: #cdd6f4; }
KUrlNavigator QAbstractButton:hover { background-color: rgba(151,125,186,65); }
KUrlNavigator QAbstractButton:focus { border-color: #cba6f7; }
/* Keep the native clear action independent of toolbar button dimensions. */
KUrlNavigator QLineEdit QToolButton { min-width: 0px; min-height: 0px; padding: 0px; border: none; background: transparent; }
QStatusBar { background: transparent; border: none; }
QDockWidget { background: transparent; border: none; }
QSplitter::handle { background: transparent; width: 4px; height: 4px; }

QMainWindow { background-color: rgba(24,24,37,178); }
PlacesPanel, PlacesPanel > QWidget, PlacesPanel > QWidget > QWidget { background: transparent; border: none; }
QHeaderView, QHeaderView::section { background: transparent; color: #a6adc8; border: none; }

DolphinStatusBar { background: transparent; border: none; }

/* Back from all viewport: titles, icons, chips and capability together. */
KFilePlacesView { padding-left: 12px; padding-right: 12px; color: #cdd6f4; selection-background-color: #cba6f7; selection-color: #11111b; }

/* Settings and auxiliary dialogs reuse the solid surface and control roles. */
QDialog { background-color: #181825; color: #cdd6f4; }
/* Configure uses the same unified L and central cards as the main window.
   Native page controls/search/actions remain intact; other dialogs keep their roles. */
DolphinSettingsDialog { background-color: rgba(24,24,37,178); }
DolphinSettingsDialog KPageWidget, DolphinSettingsDialog KTitleWidget,
DolphinSettingsDialog KTitleWidget QWidget { background: transparent; border: none; }
DolphinSettingsDialog KPageWidget > QFrame { background: transparent; border: none; }
DolphinSettingsDialog QWidget[ricyConfigureHeader="true"] { background-color: #313244; border: none; }
DolphinSettingsDialog QAbstractItemView[ricyConfigureNavigation="true"] {
    background: transparent; border: none; border-radius: 0px; padding: 4px 8px;
}
DolphinSettingsDialog QWidget[ricyConfigureCard="true"] {
    background-color: #313244; border: 1px solid transparent; border-radius: 12px;
}
DolphinSettingsDialog QDialogButtonBox { background: transparent; border: none; }
QComboBox { padding-right: 32px; }
QComboBox::drop-down { background: transparent; border: none; width: 24px; subcontrol-origin: padding; subcontrol-position: top right; }
QComboBox::down-arrow { image: none; width: 8px; height: 8px; }
/* Numeric fields retain native step slots, without square button backings. */
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { background: transparent; border: none; }
QSpinBox::up-arrow, QSpinBox::down-arrow, QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow { image: none; }
QComboBoxPrivateContainer[ricyConfigurePopup="true"] { background-color: #313244; border: 1px solid #46485c; border-radius: 12px; padding: 8px; }
QComboBoxPrivateContainer[ricyConfigurePopup="true"] QAbstractItemView { background-color: #313244; border: none; border-radius: 0px; padding: 0px; color: #cdd6f4; selection-background-color: #cba6f7; selection-color: #11111b; }
QComboBoxPrivateContainer[ricyConfigurePopup="true"] QAbstractItemView::item { background: transparent; border: none; border-radius: 6px; padding: 4px 12px; }
QComboBoxPrivateContainer[ricyConfigurePopup="true"] QAbstractItemView::item:selected { background-color: #cba6f7; color: #11111b; }
QComboBoxPrivateContainer[ricyConfigurePopup="true"] QAbstractItemView::item:disabled { color: #a6adc8; }
QDialog QLabel { color: #cdd6f4; background: transparent; border: none; }
QDialog QPushButton { background-color: #313244; color: #cdd6f4; border: 1px solid #46485c; border-radius: 8px; padding: 4px 12px; min-height: 20px; }
QDialog QPushButton:hover { background-color: #977dba; color: #000000; border-color: #977dba; }
QDialog QPushButton:default, QDialog QPushButton:checked, QDialog QPushButton:pressed { background-color: #cba6f7; color: #11111b; border-color: #cba6f7; }
QDialog QPushButton:focus { border-color: #cba6f7; }
QDialog QPushButton:disabled { background-color: #313244; color: #a6adc8; border-color: transparent; }
KEditToolBar QPushButton { padding: 4px 8px; }
QDialog QComboBox, QDialog QSpinBox, QDialog QDoubleSpinBox { background-color: #313244; color: #cdd6f4; border: 1px solid #46485c; border-radius: 8px; padding: 4px 8px; min-height: 20px; selection-background-color: #cba6f7; selection-color: #11111b; }
QDialog QComboBox:hover, QDialog QSpinBox:hover, QDialog QDoubleSpinBox:hover { border-color: #a6adc8; }
QDialog QComboBox:focus, QDialog QSpinBox:focus, QDialog QDoubleSpinBox:focus { border-color: #cba6f7; }
QDialog QComboBox:disabled, QDialog QSpinBox:disabled, QDialog QDoubleSpinBox:disabled { color: #a6adc8; border-color: transparent; }
QDialog QComboBox QAbstractItemView { background-color: #313244; color: #cdd6f4; selection-background-color: #cba6f7; selection-color: #11111b; }
QDialog QAbstractItemView { background-color: #313244; alternate-background-color: #313244; color: #cdd6f4; border: 1px solid transparent; border-radius: 12px; padding: 4px; selection-background-color: #cba6f7; selection-color: #11111b; }
QDialog QAbstractItemView::item { border: 1px solid transparent; border-radius: 6px; padding: 4px; }
QDialog QAbstractItemView::item:hover { background-color: #977dba; color: #000000; }
QDialog QAbstractItemView::item:selected { background-color: #cba6f7; color: #11111b; }
QDialog QAbstractItemView::item:focus { border-color: #cba6f7; }
QDialog QAbstractItemView:disabled { color: #a6adc8; }
QDialog QCheckBox, QDialog QRadioButton { color: #cdd6f4; spacing: 8px; padding: 4px 0px; }
QDialog QCheckBox:disabled, QDialog QRadioButton:disabled { color: #a6adc8; }
QDialog QLineEdit:disabled { color: #a6adc8; border-color: transparent; }
QDialog QGroupBox { color: #a6adc8; border: 1px solid #46485c; border-radius: 12px; margin-top: 12px; padding: 12px; }
QDialog QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 12px; padding: 0px 4px; }
/* Auxiliary panels are solid content cards; keep embedded terminal paint native. */
InformationPanel, FoldersPanel, TerminalPanel { background-color: #313244; border: 1px solid transparent; border-radius: 12px; padding: 8px; margin: 4px 4px 8px 4px; }
InformationPanel[ricyRightEdge="true"], FoldersPanel[ricyRightEdge="true"], TerminalPanel[ricyRightEdge="true"] { margin-right: 8px; }
InformationPanel[ricyLeftEdge="true"], FoldersPanel[ricyLeftEdge="true"], TerminalPanel[ricyLeftEdge="true"] { margin-left: 8px; }
InformationPanel QLabel { color: #cdd6f4; }
FoldersPanel QTreeView { background: transparent; color: #cdd6f4; border: none; selection-background-color: #cba6f7; selection-color: #11111b; }
FoldersPanel QTreeView::item { border-radius: 6px; padding: 4px; }
FoldersPanel QTreeView::item:hover { background-color: #977dba; color: #000000; }
FoldersPanel QTreeView::item:selected { background-color: #cba6f7; color: #11111b; }
/* The helper aligns native dock titles; locked panels retain their empty title. */
/* Keep native close actions and dock dragging; expose a full control hit area. */
QDockWidget::close-button { background: #313244; border: 1px solid transparent; border-radius: 8px; }
QDockWidget::close-button:hover { background: #977dba; border-color: #977dba; }
QDockWidget::close-button:pressed { background: #cba6f7; border-color: #cba6f7; }
QDockWidget::close-button:disabled { background: transparent; border-color: transparent; }
/* Slider owns only zoom paint; native range, wheel and keyboard remain intact. */
QSlider:horizontal { min-height: 20px; }
QSlider::groove:horizontal { background: #46485c; height: 6px; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #cba6f7; border-radius: 3px; }
QSlider::handle:horizontal { background: #cba6f7; border: 1px solid #cba6f7; border-radius: 6px; width: 12px; margin: -3px 0px; }
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed { background: #977dba; border-color: #977dba; }
QSlider::handle:horizontal:focus { border-color: #cdd6f4; }
QSlider::handle:horizontal:disabled { background: #a6adc8; border-color: #a6adc8; }
/* Compact disk-space button must fit the status row instead of toolbar padding. */
DolphinStatusBar QToolButton { padding: 0px 4px; border-radius: 6px; }
