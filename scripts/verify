#!/usr/bin/env python3
"""Offline checks; never install, activate or repair the desktop."""
import ast
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tomllib
from urllib.parse import unquote, urlsplit

ROOT = Path(__file__).resolve().parents[1]
SKILLS = ('architecture-change', 'component-development', 'visual-development',
          'noctalia-development', 'kwin-development', 'testing', 'documentation')
DOCS = ('ARCHITECTURE', 'INVARIANTS', 'COMPONENTS', 'DESIGN-SYSTEM',
        'DEVELOPMENT', 'RECOVERY', 'MIGRATION-PLAN', 'CHANGELOG')
ADRS = ('0001-single-workspace', '0002-plasma-recovery', '0003-ricy-files',
        '0004-agent-first-development', '0006-service-template-source-lookup',
        '0011-dolphin-as-ricy-file-manager')
LOCAL = ('core', 'shell', 'compositor', 'apps', 'services', 'themes',
         'integrations', 'recovery', 'installer', 'tools', 'scripts',
         'ricy-kit', 'ricy-kit/contributions', 'docs/ricy-kit',
         'ricy-kit/contributions/plasma-noctalia-switching',
         'ricy-kit/contributions/noctalia-kde-integration-and-menus',
         'ricy-kit/contributions/app-icon-reordering',
         'ricy-kit/contributions/blur-continuity',
         'ricy-kit/contributions/noctalia-visual-identity',
         'ricy-kit/contributions/dolphin-blur-corners')
PAGES = ('shell/noctalia/README.md', 'compositor/kwin/README.md',
         'docs/DOLPHIN-BASELINE.md', 'recovery/plasma/README.md',
         'themes/tokens/README.md', '.agents/references/README.md', 'docs/adr/README.md')
# Explicit HISTORICAL entries from CONTRIBUTION-AUDIT; mixed-role folders stay.
HISTORICAL_VARIANTS = ('taskbar-menu-composition', 'tray-menu-composition',
                       'app-icon-interactions', 'taskbar-app-actions',
                       'app-indicator-animations', 'app-icon-states')
HISTORICAL_BUILDS = ('notification-continuity', *HISTORICAL_VARIANTS)
HISTORICAL_FILES = {
    'prepare-environment.py', 'generate-kvantum-variant.py',
    'contributions/notification-continuity/build.sh',
    'contributions/app-icon-reordering/apply-animations.py',
}
failed = 0
skipped = 0


def report(state, message):
    global failed, skipped
    print(f'{state} {message}', flush=True)
    failed += state == 'FAIL'
    skipped += state == 'UNKNOWN'


def run(label, command, timeout=60, env=None):
    try:
        result = subprocess.run(command, cwd=ROOT, env=env, text=True,
                                capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as error:
        report('FAIL', f'{label}: {error}')
        return False
    if result.returncode:
        report('FAIL', f'{label} (exit {result.returncode})')
        print((result.stdout + result.stderr).strip())
        return False
    report('PASS', label)
    if result.stdout.strip():
        print(result.stdout.strip())
    return True


def not_run(message):
    global skipped
    skipped += 1
    print(f'NOT RUN {message}', flush=True)


def markdown_body(text):
    # Exclude fenced code; keep ordinary inline/reference Markdown links.
    return re.sub(r'^\s*(`{3,}|~{3,}).*?^\s*\1\s*$', '', text,
                  flags=re.MULTILINE | re.DOTALL)


def link_targets(text):
    body = markdown_body(text)
    inline = re.findall(r'!?\[[^\]\n]*\]\(\s*(<[^>]+>|[^\s)]+)(?:\s+[^)]*)?\)', body)
    refs = dict(re.findall(r'^\s*\[([^\]]+)\]:\s*(<[^>]+>|\S+)', body, re.MULTILINE))
    # Return undefined explicit/collapsed references separately.
    for label, ref in re.findall(r'!?\[([^\]\n]+)\]\[([^\]\n]*)\]', body):
        key = ref or label
        matched = next((value for name, value in refs.items()
                        if name.casefold() == key.casefold()), None)
        if matched is None:
            yield None, f'undefined reference [{key}]'
    for target in inline + list(refs.values()):
        yield target.strip('<>'), None


def architecture():
    if (ROOT / 'apps/file-manager').exists():
        report('FAIL', 'Retired apps/file-manager is present; ADR-0011 selects Dolphin')
    else:
        report('PASS', 'Own file-manager implementation absent under ADR-0011')
    required = ['AGENTS.md', 'CLAUDE.md', 'README.md', 'scripts/verify', 'scripts/doctor', 'scripts/test-foundation.py']
    required += [f'services/{name}.service.in' for name in
                 ('noctalia-test', 'noctalia-desktop-search', 'ricy-noctalia-integration')]
    required += [f'docs/{name}.md' for name in DOCS]
    required += [f'docs/adr/{name}.md' for name in ADRS]
    required += [f'.agents/skills/{name}/SKILL.md' for name in SKILLS]
    required += [f'{name}/AGENTS.md' for name in LOCAL] + list(PAGES)
    missing = [name for name in required if not (ROOT / name).is_file()]
    for name in missing:
        report('FAIL', f'Required file missing: {name}')
    if not missing:
        report('PASS', f'{len(required)} mandatory files present')
    for script in ('verify', 'doctor', 'test-foundation.py'):
        path = ROOT / 'scripts' / script
        if path.is_file():
            if script != 'test-foundation.py' and not os.access(path, os.X_OK):
                report('FAIL', f'scripts/{script} not executable')
            try:
                ast.parse(path.read_text(), filename=str(path))
                report('PASS', f'scripts/{script}: Python syntax')
            except (OSError, SyntaxError) as error:
                report('FAIL', f'{path.name}: {error}')
    for name in SKILLS:
        path = ROOT / '.agents/skills' / name / 'SKILL.md'
        if not path.is_file():
            continue
        text = path.read_text()
        match = re.match(r'\A---\n(.*?)\n---\n', text, re.DOTALL)
        if not match or not re.search(rf'^name: {re.escape(name)}$', match[1], re.MULTILINE) or not re.search(r'^description: \S.+$', match[1], re.MULTILINE):
            report('FAIL', f'frontmatter da skill {name}')
        elif re.search(r'\b(TODO|TBD)\b', text):
            report('FAIL', f'scaffold incompleto na skill {name}')
    pages = {ROOT / name for name in required if name.endswith('.md')}
    pages.update((ROOT / 'docs').glob('*.md'))
    # Historical documents are preserved, outside foundation link scope.
    pages.difference_update(ROOT / 'docs' / name for name in ('ricy.md', 'REINSTALL.md', 'VISUAL-IDENTITY.md'))
    pages.update((ROOT / 'docs/adr').glob('*.md'))
    pages.update(ROOT.rglob('AGENTS.md'))
    before = failed
    count = 0
    for path in sorted(pages):
        if not path.is_file():
            continue
        text = path.read_text()
        valid_doc = False
        for target, error in link_targets(text):
            if error:
                report('FAIL', f'{path.relative_to(ROOT)}: {error}')
                continue
            parts = urlsplit(target)
            if parts.scheme or parts.netloc or not parts.path:
                continue
            resolved = (path.parent / unquote(parts.path)).resolve()
            count += 1
            if not resolved.exists():
                report('FAIL', f'{path.relative_to(ROOT)}: broken link {target}')
            elif resolved.is_file() and resolved.suffix == '.md' and (ROOT / 'docs') in resolved.parents:
                valid_doc = True
        if path.name == 'AGENTS.md' and path != ROOT / 'AGENTS.md' and not valid_doc:
            report('FAIL', f'{path.relative_to(ROOT)}: missing reference to valid docs/ documentation')
    if before == failed:
        report('PASS', f'{count} local links of the foundation; local AGENTS point to docs')
    print('NOT APPLICABLE external URLs, anchors and historical links are not checked')


def source_files():
    excluded = {'work', 'outputs', 'backups', 'assets', '__pycache__', '.git'}
    files = list((ROOT / 'ricy-kit').glob('*.py'))
    for path in (ROOT / 'ricy-kit/contributions').rglob('*'):
        if path.is_file() and not excluded.intersection(path.relative_to(ROOT / 'ricy-kit/contributions').parts):
            if path.suffix in {'.py', '.sh', '.json', '.toml'} or path.name == 'ricy':
                files.append(path)
    # The first migrated source has no resident service; retain syntax coverage.
    files += [ROOT / 'integrations/keyboard-cedilla' / name
              for name in ('apply.py', 'apply-brave.py')]
    files += [ROOT / name for name in ('start.sh', 'return.sh', 'switch.sh')]
    kit = ROOT / 'ricy-kit'
    return sorted({path for path in files
                   if not path.is_relative_to(kit) or (
                       path.relative_to(kit).as_posix() not in HISTORICAL_FILES
                       and not any(path.is_relative_to(kit / 'contributions' / name)
                                   for name in HISTORICAL_VARIANTS))})


def shell():
    before = failed
    files = source_files()
    if not files:
        report('FAIL', 'no kit source found')
        return
    bash = shutil.which('bash')
    for path in files:
        try:
            if path.suffix == '.py':
                ast.parse(path.read_text(), filename=str(path))
            elif path.suffix == '.json':
                json.loads(path.read_text())
            elif path.suffix == '.toml':
                tomllib.loads(path.read_text())
            elif bash:
                result = subprocess.run([bash, '-n', str(path)], capture_output=True, text=True, timeout=10)
                if result.returncode:
                    report('FAIL', f'{path.relative_to(ROOT)}: {result.stderr.strip()}')
            else:
                not_run(f'Bash unavailable: {path.relative_to(ROOT)}')
        except (OSError, ValueError, SyntaxError, subprocess.TimeoutExpired) as error:
            report('FAIL', f'{path.relative_to(ROOT)}: {error}')
    if failed == before:
        report('PASS', f'syntax of available files ({len(files)} candidates; skips listed separately)')
    print('NOT APPLICABLE historical recipes excluded from normal source checks; mixed-role helpers retained')
    if bash:
        for name in HISTORICAL_BUILDS:
            run(f'{name}: historical build guard syntax',
                [bash, '-n', str(ROOT / 'ricy-kit/contributions' / name / 'build.sh')])
    else:
        not_run('historical build guard syntax: Bash unavailable')
    source = Path(os.environ.get('RICY_NOCTALIA_SOURCE',
                  str(Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'ricy-noctalia-src-5.2.1')))
    test = ROOT / 'ricy-kit/contributions/app-icon-reordering/validate-actions.py'
    if not test.is_file():
        report('FAIL', 'existing Noctalia action validator missing')
        return
    if not (source / 'src/compositors/kde/kwin_active_window.cpp').is_file() or not shutil.which('git'):
        not_run('Noctalia actions: source in cache/git unavailable; no automatic download')
        return
    try:
        head = subprocess.run(['git', '-C', str(source), 'rev-parse', 'HEAD'], capture_output=True, text=True, timeout=10)
        diff = subprocess.run(['git', '-C', str(source), 'diff', '--binary', 'HEAD'], capture_output=True, timeout=10)
        expected = (ROOT / 'ricy-kit/contributions/app-icon-reordering/noctalia-ricy.patch').read_bytes()
        if head.returncode or head.stdout.strip() != '6ef43e2bf2f3d5b4205ec72a72e34a2ab76ce3b4' or diff.returncode or diff.stdout != expected:
            not_run('Noctalia actions: cache does not exactly match the expected commit/patch')
            return
    except (OSError, subprocess.TimeoutExpired) as error:
        not_run(f'Noctalia actions: unverifiable origin: {error}')
        return
    qt_test('Noctalia actions in isolated QJSEngine', test, ['--fonte', str(source)])
    native_test = ROOT / 'ricy-kit/contributions/app-icon-reordering/validate-native-drag.py'
    if (source / 'build-ricy/noctalia').is_file() and shutil.which('c++'):
        run('Noctalia single-space policy and drag (offline)',
            [sys.executable, '-B', str(native_test), '--fonte', str(source)])
    else:
        not_run('Noctalia single-space/native drag: matching build or C++ compiler unavailable')


def qt_test(label, path, args=()):
    if not path.is_file():
        report('FAIL', f'Missing validator: {path.relative_to(ROOT)}')
        return
    probe = subprocess.run([sys.executable, '-B', '-c', 'from PyQt6.QtQml import QJSEngine'], capture_output=True, timeout=15)
    if probe.returncode:
        not_run(f'{label}: PyQt6.QtQml not available in this Python')
        return
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', QT_QPA_PLATFORM='offscreen', PYTHONOPTIMIZE='')
    run(label, [sys.executable, '-B', str(path), *args], env=env)


def recovery():
    path = ROOT / 'ricy-kit/contributions/plasma-noctalia-switching/verify.py'
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONOPTIMIZE='')
    run('capture/merge panels and data preservation (offline)', [sys.executable, '-B', str(path)], env=env)
    qt_test('window effect (offline)', ROOT / 'ricy-kit/contributions/window-fade-expand/validate.py')
    print('NOT RUN live recovery: switching, persistent failure, login, and Dolphin not exercised')


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {'architecture', 'shell', 'recovery', 'all'}:
        print('Usage: scripts/verify {architecture|shell|recovery|all}', file=sys.stderr)
        return 2
    scopes = {'architecture': architecture, 'shell': shell, 'recovery': recovery}
    for name, check in scopes.items():
        if sys.argv[1] in {name, 'all'}:
            try:
                check()
            except Exception as error:
                report('FAIL', f'{name}: {type(error).__name__}: {error}')
    print(f'Offline result: {failed} failure(s), {skipped} unavailable check(s). This does not certify a live session.')
    return 1 if failed else 2 if skipped else 0


if __name__ == '__main__':
    sys.exit(main())
