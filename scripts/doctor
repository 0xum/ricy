#!/usr/bin/env python3
"""Read-only diagnostics. UNKNOWN never means the desktop is healthy."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

unknown = 0


def emit(state, message):
    global unknown
    unknown += state == 'UNKNOWN'
    print(f'{state} {message}', flush=True)


def query(command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=8)
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None, ''


def main():
    print('Diagnostics of observed presence and state; this does not test functionality or perform repairs.')
    emit('KNOWN', f'Python {sys.version.split()[0]}')
    try:
        fields = dict(line.split('=', 1) for line in Path('/etc/os-release').read_text().splitlines() if '=' in line)
        emit('KNOWN', 'Reported OS: ' + fields.get('PRETTY_NAME', fields.get('ID', 'unidentified')).strip('"'))
    except OSError:
        emit('UNKNOWN', '/etc/os-release unavailable')
    for name in ('XDG_SESSION_TYPE', 'XDG_CURRENT_DESKTOP', 'WAYLAND_DISPLAY'):
        value = os.environ.get(name)
        emit('KNOWN' if value else 'UNKNOWN', f'{name}: {value or "not declared"} (environment, not session proof)')
    for name in ('bash', 'python3', 'systemctl', 'qdbus6', 'flock', 'kbuildsycoca6', 'noctalia', 'kwin_wayland', 'plasmashell', 'dolphin', 'systemsettings'):
        path = shutil.which(name)
        emit('KNOWN' if path else 'UNKNOWN', f'{name}: {path or "not found in PATH"}')
    if shutil.which('pacman'):
        for package in ('noctalia', 'kwin', 'plasma-workspace', 'dolphin'):
            code, output = query(['pacman', '-Q', package])
            emit('KNOWN' if code == 0 and output else 'UNKNOWN', f'package: {output if code == 0 and output else package + " unavailable/missing"}')
    else:
        emit('UNKNOWN', 'pacman unavailable; package versions not queried')
    if shutil.which('systemctl'):
        for unit in ('noctalia-teste.service', 'noctalia-busca-desktop.service', 'ricy-noctalia-integracao.service', 'plasma-plasmashell.service'):
            code, output = query(['systemctl', '--user', 'show', unit, '--property=LoadState,ActiveState,SubState,UnitFileState'])
            values = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
            if code == 0 and values.get('LoadState') == 'loaded' and values.get('ActiveState'):
                emit('KNOWN', f'{unit}: ' + ', '.join(f'{key}={value}' for key, value in values.items()))
            else:
                emit('UNKNOWN', f'{unit}: unit not loaded or user bus inaccessible')
    else:
        emit('UNKNOWN', 'user systemd not queried')
    entries = list(Path('/usr/share/wayland-sessions').glob('*plasma*.desktop'))
    emit('KNOWN' if entries else 'UNKNOWN', 'Plasma Wayland entry: ' + (', '.join(str(p) for p in entries) if entries else 'not located'))
    emit('UNKNOWN', 'login, panels, interactive Dolphin, and recovery after failure: require a live test')
    emit('UNKNOWN', 'RICY-001 across session menus, shortcuts, and gestures: audit pending')
    print(f'{unknown} UNKNOWN items. No configuration changed.')
    return 2 if unknown else 0


if __name__ == '__main__':
    sys.exit(main())
