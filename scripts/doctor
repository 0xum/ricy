#!/usr/bin/env python3
"""Diagnóstico somente leitura. UNKNOWN nunca é PASS de saúde do desktop."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

unknown = 0


def emit(state, message):
    global unknown
    unknown += state == 'UNKNOWN'
    print(f'{state} {message}', flush=True)


def query(command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=8)
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None, ''


def main():
    print('Diagnóstico de presença/estado observado; não é teste de funcionamento ou reparo.')
    emit('KNOWN', f'Python {sys.version.split()[0]}')
    try:
        fields = dict(line.split('=', 1) for line in Path('/etc/os-release').read_text().splitlines() if '=' in line)
        emit('KNOWN', 'OS declarado: ' + fields.get('PRETTY_NAME', fields.get('ID', 'não identificado')).strip('"'))
    except OSError:
        emit('UNKNOWN', '/etc/os-release indisponível')
    for name in ('XDG_SESSION_TYPE', 'XDG_CURRENT_DESKTOP', 'WAYLAND_DISPLAY'):
        value = os.environ.get(name)
        emit('KNOWN' if value else 'UNKNOWN', f'{name}: {value or "não declarado"} (ambiente, não prova de sessão)')
    for name in ('bash', 'python3', 'systemctl', 'qdbus6', 'flock', 'kbuildsycoca6', 'noctalia', 'kwin_wayland', 'plasmashell', 'dolphin', 'systemsettings'):
        path = shutil.which(name)
        emit('KNOWN' if path else 'UNKNOWN', f'{name}: {path or "não encontrado no PATH"}')
    if shutil.which('pacman'):
        for package in ('noctalia', 'kwin', 'plasma-workspace', 'dolphin'):
            code, output = query(['pacman', '-Q', package])
            emit('KNOWN' if code == 0 and output else 'UNKNOWN', f'pacote: {output if code == 0 and output else package + " não consultável/ausente"}')
    else:
        emit('UNKNOWN', 'pacman ausente; versões de pacotes não consultadas')
    if shutil.which('systemctl'):
        for unit in ('noctalia-teste.service', 'noctalia-busca-desktop.service', 'ricy-noctalia-integracao.service', 'plasma-plasmashell.service'):
            code, output = query(['systemctl', '--user', 'show', unit, '--property=LoadState,ActiveState,SubState,UnitFileState'])
            values = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
            if code == 0 and values.get('LoadState') == 'loaded' and values.get('ActiveState'):
                emit('KNOWN', f'{unit}: ' + ', '.join(f'{key}={value}' for key, value in values.items()))
            else:
                emit('UNKNOWN', f'{unit}: unidade não carregada ou barramento de usuário inacessível')
    else:
        emit('UNKNOWN', 'systemd de usuário não consultado')
    entries = list(Path('/usr/share/wayland-sessions').glob('*plasma*.desktop'))
    emit('KNOWN' if entries else 'UNKNOWN', 'entrada Plasma Wayland: ' + (', '.join(str(p) for p in entries) if entries else 'não localizada'))
    emit('UNKNOWN', 'login, painéis, Dolphin interativo e recovery após falha: exigem ensaio real')
    emit('UNKNOWN', 'RICY-001 em menus/atalhos/gestos da sessão inteira: auditoria pendente')
    print(f'{unknown} informação(ões) UNKNOWN. Nenhuma configuração alterada.')
    return 2 if unknown else 0


if __name__ == '__main__':
    sys.exit(main())
